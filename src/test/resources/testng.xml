<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Noon Egypt Automation Suite" verbose="1">

    <!-- Guest flows: no account, no session needed. -->
    <test name="Guest flows">
        <classes>
            <class name="tests.SearchTest"/>
            <class name="tests.FooterSocialMediaTest"/>
        </classes>
    </test>

    <!-- Signed-in flows. SignInTest runs first so the shared browser profile
         (reuse.session=true) already holds a session for the tests that follow,
         which keeps the suite to a single login. LocationTest belongs here too:
         noon only collects receiver details for a signed-in visitor. -->
    <test name="Authenticated flows">
        <classes>
            <class name="tests.SignInTest"/>
            <class name="tests.ProfileTest"/>
            <class name="tests.LocationTest"/>
            <class name="tests.WishlistTest"/>
            <class name="tests.CheckoutPaymentTest"/>
        </classes>
    </test>
</suite>
